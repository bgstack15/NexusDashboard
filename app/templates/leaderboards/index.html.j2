{% extends 'base.html.j2' %}

{% block title %}
  Leaderboards
{% endblock title %}

{% block content %}
  {% if message %}
    <div class="row">
      <div class="col text-center">
        <h3>{{ message }}</h3>
      </div>
    </div>
    <br/>
  {% endif %}
  <form id="activityForm" method=post>
    <div class="" style="width: 50rem;">
      {{ form.csrf_token }}
      {{ helper.render_field(form.activity, submit_on_change=True) }}
      {{ helper.render_submit_field(form.submit) }}
    </div>
  </form>
  <table class="table table-dark table-striped table-bordered table-hover" id="leaderboards_table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Primary</th>
            <th>Secondary</th>
            <th>Tertiary</th>
            <th>Times played</th>
            <th>Last played</th>
            <th>Name</th>
            <th>game_id</th>
        </tr>
    </thead>
    <tbody></tbody>
</table>
{% endblock  %}


{% block js %}
  {{ super () }}
  <script>
    $(document).ready(function(){
        let leaderboards_table = $('#leaderboards_table').DataTable({
            "processing": true,
            "serverSide": true,
            "ajax": "{{ url_for('leaderboards.get', id=id) }}",
            "columnDefs": [
              { "searchable": false, "targets": [7] },
              { "orderable": false, "targets": [7] },
              { "visible": false, "targets": [6,7] }
            ]
          });
        });
    function submitForm() {
      document.getElementById("activityForm").submit();
    }
  </script>
{% endblock %}
